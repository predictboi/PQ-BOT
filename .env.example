# ===== 비밀 (Environment Secrets / Railway Variables / git-ignored .env 에만) =====
MNEMONIC=                      # 24 words. 모든 지갑(FUNDER/CREATOR/TRADER 01~30)의 루트
RPC_URL=                       # QuickNode Solana mainnet URL (API key 포함). 비우면 public RPC(읽기 전용 수준)
DASHBOARD_TOKEN=               # 대시보드 로그인 토큰(어드민 키). 비우면 인증 없음 (로컬 전용)
GEMINI_API_KEY=                # 선택: 썸네일 생성 (없으면 로컬 추상 썸네일)
ANTHROPIC_API_KEY=             # 선택: 마켓 제목/설명 한국어 작성 (없으면 템플릿)
ADMIN_SECRET_KEY=              # 선택: 플랫폼 어드민 지갑 bs58 secret. 크리에이터 승격 1회 + 해결 권한 폴백에만 사용
MASTER_SECRET_KEY=             # 선택: 마스터 지갑 bs58 secret. bin/fund.js --from-master 로 FUNDER 입금할 때만 사용

# ===== 공개 =====
POLYQUEST_API_BASE=https://solana-stg.polyquest.xyz
PUBLIC_BASE_URL=               # 대시보드 공개 URL (Railway). 썸네일 호스팅에 사용. 예: https://polyquest-bot.up.railway.app
PORT=8787
