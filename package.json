{
  "name": "polyquest-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Polyquest (Solana staging) operations bots: creator / 30 traders / Polymarket odds sync, multi-agent supervisor + dashboard",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/run.js",
    "dashboard": "node bin/run.js --dashboard-only",
    "init-wallets": "node bin/init-wallets.js",
    "gen-mnemonic": "node bin/gen-mnemonic.js",
    "fund": "node bin/fund.js",
    "status": "node bin/status.js",
    "creator": "node bin/run-creator.js",
    "trader": "node bin/run-trader.js",
    "odds-sync": "node bin/run-odds-sync.js",
    "resolve-check": "node bin/resolve-check.js",
    "sweep": "node bin/sweep.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bip39": "^3.1.2",
    "bn.js": "^5.2.2",
    "bs58": "^6.0.0",
    "dotenv": "^16.6.1",
    "ed25519-hd-key": "^1.3.0",
    "node-cron": "^3.0.3"
  },
  "optionalDependencies": {
    "sharp": "^0.33.5"
  }
}
